# MapLeads Frontend Environment Variables

NEXT_PUBLIC_API_KEY=your-api-key-here
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Maps JavaScript API key for the shared <LeadsMap> component.
# Without it the map renders a friendly "unavailable" message instead of crashing.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional cloud-based map style id (required by Google for Advanced Markers).
# Falls back to Google's demo map id when unset.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
