# MapLeads Frontend Environment Variables

NEXT_PUBLIC_API_KEY=your-api-key-here
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public origin of this Next.js app, as your browser reaches it (not the
# container's bind address). Used to build absolute redirect URLs in Route
# Handlers (e.g. the OAuth callback) instead of the request's Host header,
# which can resolve to 0.0.0.0 when the dev/prod server is bound to 0.0.0.0
# (as it is in Docker). Must match the FRONTEND_URL configured on the backend.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Maps JavaScript API key for the shared <LeadsMap> component.
# Without it the map renders a friendly "unavailable" message instead of crashing.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional cloud-based map style id (required by Google for Advanced Markers).
# Falls back to Google's demo map id when unset.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
