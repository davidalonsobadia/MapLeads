# MapLeads Caddy configuration for local testing of the `--profile production`
# service in the dev docker-compose.yml. The real production deploy (Hetzner)
# uses caddy/Caddyfile + docker-compose.prod.yml instead — see that file.

:80 {
    handle /api/v1/* {
        reverse_proxy api:8000
    }
    handle /docs {
        reverse_proxy api:8000
    }
    handle /openapi.json {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy frontend:3000
    }
}
