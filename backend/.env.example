# MapLeads Backend Environment Variables

# Application Environment
APP_ENV=development

# Docker Compose Configuration
# Set to 1 for development to enable hot-reload and auto-install dependencies
INSTALL_DEPS_ON_START=1
API_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8080

# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/mapleads_db

# Redis Configuration (for Celery)
REDIS_URL=redis://redis:6379/0

# JWT Secret Key (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars

# CORS Origins (comma-separated)
CORS_ORIGINS='["http://localhost:3000","http://localhost:8000"]'

# Email Configuration (Resend)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:3000

# Google Maps Platform - Places API (New) key (enable "Places API (New)")
# Leave empty locally; do not commit a real key.
GOOGLE_PLACES_API_KEY=

# Stripe billing (Checkout, Billing Portal, webhook)
# Leave empty locally; the billing endpoints return 503 until configured.
# Never commit real secrets. Live billing requires a human to provision these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring price ids per purchasable plan (from the Stripe dashboard).
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Social login (OAuth) for Google and GitHub
# Leave empty locally; the OAuth client treats an empty pair as "unconfigured".
# Never commit real secrets. Configure these in the provider consoles.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Internal API key gating staff/machine endpoints (e.g. promo-code creation).
# Separate from the customer-facing x-api-key gateway. Leave empty locally; the
# gated endpoints return 503 until configured. Never commit a real value.
INTERNAL_API_KEY=

# Sentry Configuration (Optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Testing
TESTING=0

